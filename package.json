		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-svelte3": "^4.0.0",
		"prettier": "^3.6.2",
		"svelte": "^5.38.2",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.2",
		"vite": "^7.0.4"
